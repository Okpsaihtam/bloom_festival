{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "nom": {
            "type": "string"
        },
        "type": {
            "type": "string",
            "enum": [
                "plein_air",
                "chapiteau",
                "salle"
            ]
        },
        "capacite": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
        },
        "localisation": {
            "type": "object",
            "properties": {
                "zone": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                }
            }
        },
        "equipements": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "accessiblePMR": {
            "type": "boolean"
        },
        "concerts": {
            "type": "array",
            "maxItems": 10,
            "items": {
                "type": "object",
                "properties": {
                    "titre": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "dateDebut": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "dateFin": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "genre": {
                        "type": "string",
                        "enum": [
                            "rock",
                            "pop",
                            "electro",
                            "rap"
                        ]
                    },
                    "statut": {
                        "type": "string",
                        "enum": [
                            "programme",
                            "en_vente",
                            "complet",
                            "annule",
                            "termine"
                        ]
                    },
                    "artistes": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "properties": {
                                "nom": {
                                    "type": "string"
                                },
                                "pays": {
                                    "type": "string"
                                },
                                "role": {
                                    "type": "string",
                                    "enum": [
                                        "tete_affiche",
                                        "premiere_partie",
                                        "invite"
                                    ]
                                },
                                "heurePassage": {
                                    "type": "string",
                                    "format": "date-time"
                                },
                                "biographie": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "nom",
                                "role"
                            ]
                        }
                    },
                    "categories": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "properties": {
                                "code": {
                                    "type": "string",
                                    "enum": [
                                        "standard",
                                        "reduit",
                                        "vip"
                                    ]
                                },
                                "libelle": {
                                    "type": "string"
                                },
                                "prix": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 500
                                }
                            },
                            "required": [
                                "code",
                                "prix"
                            ]
                        }
                    },
                    "tarifMin": {
                        "type": "number",
                        "minimum": 0
                    },
                    "jauge": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "dateMiseEnVente": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "billets": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "code": {
                                    "type": "string",
                                    "pattern": "^BLM-[A-Z0-9]{4}-[A-Z0-9]{4}$"
                                },
                                "categorie": {
                                    "type": "string",
                                    "enum": [
                                        "standard",
                                        "reduit",
                                        "vip"
                                    ]
                                },
                                "prix": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 500
                                },
                                "dateAchat": {
                                    "type": "string",
                                    "format": "date-time"
                                },
                                "statut": {
                                    "type": "string",
                                    "enum": [
                                        "valide",
                                        "utilise",
                                        "annule"
                                    ]
                                },
                                "acheteur": {
                                    "type": "object",
                                    "properties": {
                                        "nom": {
                                            "type": "string"
                                        },
                                        "prenom": {
                                            "type": "string"
                                        },
                                        "email": {
                                            "type": "string",
                                            "format": "email"
                                        }
                                    },
                                    "required": [
                                        "nom",
                                        "prenom",
                                        "email"
                                    ]
                                },
                                "controle": {
                                    "type": "object",
                                    "properties": {
                                        "dateScan": {
                                            "type": "string",
                                            "format": "date-time"
                                        },
                                        "vigile": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "code",
                                "categorie",
                                "prix",
                                "dateAchat",
                                "statut",
                                "acheteur"
                            ]
                        }
                    },
                    "alertes": {
                        "type": "array",
                        "maxItems": 500,
                        "items": {
                            "type": "object",
                            "properties": {
                                "email": {
                                    "type": "string",
                                    "format": "email"
                                },
                                "dateCreation": {
                                    "type": "string",
                                    "format": "date-time"
                                },
                                "envoyee": {
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "email"
                            ]
                        }
                    }
                },
                "required": [
                    "titre",
                    "dateDebut",
                    "dateFin",
                    "genre",
                    "statut",
                    "artistes",
                    "categories",
                    "tarifMin",
                    "jauge",
                    "billets"
                ]
            }
        }
    },
    "required": [
        "nom",
        "type",
        "capacite",
        "concerts"
    ]
}
